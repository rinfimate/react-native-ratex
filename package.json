{
  "name": "react-native-ratex",
  "version": "0.2.3",
  "description": "LaTeX renderer for React Native and React Native Web. No DOM. No WebView. Pure Rust.",
  "main": "./lib/module/index.js",
  "source": "./src/index.tsx",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "browser": "./lib/module/index.web.js",
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "RatexFramework.xcframework",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!ios/generated",
    "!android/build",
    "!android/generated/java",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build lib",
    "prepare": "bob build && node scripts/copy-wasm-to-lib.js",
    "typecheck": "tsc",
    "ubrn:ios": "ubrn build ios",
    "ubrn:android": "ubrn build android",
    "ubrn:web": "wasm-pack build rust_modules/wasm --target web --out-dir ../../src/generated/web/wasm-bindgen && node scripts/patch-wasm.js",
    "ubrn:web-release": "wasm-pack build rust_modules/wasm --target web --release --out-dir ../../src/generated/web/wasm-bindgen && node scripts/patch-wasm.js",
    "ubrn:clean": "del-cli cpp ios src/generated src/Native* src/index.*ts*",
    "ubrn:generate": "node scripts/generate-bindings.js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "latex",
    "math",
    "katex",
    "svg",
    "rust",
    "wasm",
    "web",
    "no-webview",
    "turbo-module",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinfimate/react-native-ratex.git"
  },
  "author": "Rochanglien Infimate <r.infimate@gmail.com> (https://github.com/rinfimate)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rinfimate/react-native-ratex/issues"
  },
  "homepage": "https://github.com/rinfimate/react-native-ratex#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.77.0",
    "@types/react": "^18.3.0",
    "del-cli": "^7.0.0",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "generated/web/wasm-bindgen/**",
    "targets": [
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json" }],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "RatexSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.ratex"
    },
    "includesGeneratedCode": true
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "^0.31.0-2"
  }
}
